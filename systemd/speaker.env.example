# Environment of the speaker's systemd services; install.sh copies this to
# ~/.config/speaker/env (once; later edits are yours). Restart after changing:
#   systemctl --user restart speaker.target

# Must contain llama-server, nemo-speech and ffmpeg.
PATH=/usr/local/bin:/usr/bin:/bin

# LocalVQE echo canceller library (or set [audio] echo_cancellation = false).
LOCALVQE_LIB=/usr/local/lib/liblocalvqe.so

# The system ALSA config plus the speaker's shared speaker_in/speaker_out devices.
# Debian, Ubuntu, Fedora and Arch keep alsa.conf in /usr/share/alsa.
ALSA_CONFIG_PATH=/usr/share/alsa/alsa.conf:@DIR@/alsa/speaker.conf

# Another config file, e.g. one kept out of git with your own settings.
#SPEAKER_CONFIG=@DIR@/config.local.toml

# Secrets named in config.toml (only the ones you use).
#PARALLEL_API_KEY=
#REMOTE_LLM_API_KEY=
#NAVIDROME_PASSWORD=
#YANDEX_MUSIC_TOKEN=  # usually not needed: `speaker yandex-login` saves it to state/yandex_token
